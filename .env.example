# ======================================================
# PROJECT CONFIGURATION
# ======================================================
PROJECT_NAME=BizTrack
PROJECT_URL=https://github.com/UnderWeb/biztrack-api
PROJECT_EMAIL=mail@gmail.com

# ======================================================
# ENVIRONMENT CONFIGURATION
# ======================================================
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.${DJANGO_ENV}
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ======================================================
# DJANGO SETTINGS
# ======================================================
DEBUG=True
SECRET_KEY=replace-with-your-own-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SERVER_PORT=8000

# ======================================================
# DATABASE (PostgreSQL)
# ======================================================
DB_USER=biztrack_user
DB_PASS=biztrack_password
DB_NAME=biztrack_db
DB_HOST=biztrack-postgres
DB_PORT=5432

# ======================================================
# REDIS (Cache & Celery Broker)
# ======================================================
REDIS_HOST=biztrack-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB_DEFAULT=1
REDIS_DB_CELERY=0

# ======================================================
# CELERY CONFIGURATION
# ======================================================
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=300
CELERY_BEAT_SCHEDULER=django_celery_beat.schedulers:DatabaseScheduler

DJANGO_CELERY_BEAT_TZ_AWARE=True

# ======================================================
# EMAIL / MAILPIT (for local development)
# ======================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=admin@localhost.dev

# ======================================================
# JWT
# ======================================================
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true

# ======================================================
# TIMEZONE & LOCALIZATION
# ======================================================
LANGUAGE_CODE=es-cl
TIME_ZONE=America/Santiago
USE_I18N=True
USE_TZ=True
